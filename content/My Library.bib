@misc{trabuccoInSTAInternetScaleTraining2025,
  title = {{{InSTA}}: {{Towards Internet-Scale Training For Agents}}},
  shorttitle = {{{InSTA}}},
  author = {Trabucco, Brandon and Sigurdsson, Gunnar and Piramuthu, Robinson and Salakhutdinov, Ruslan},
