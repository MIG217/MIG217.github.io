@misc{tangAutoAgentFullyAutomatedZeroCode2025,
  title = {{{AutoAgent}}: {{A Fully-Automated}} and {{Zero-Code Framework}} for {{LLM Agents}}},
  shorttitle = {{{AutoAgent}}},
  author = {Tang, Jiabin and Fan, Tianyu and Huang, Chao},
  year = {2025},
